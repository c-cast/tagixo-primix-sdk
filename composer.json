{
    "name": "tagixo/primix",
    "description": "Primix SDK for Tagixo: every installed builder becomes an admin resource",
    "type": "library",
    "keywords": [
        "laravel",
        "primix",
        "tagixo",
        "visual-builder"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Claudio Castorina"
        }
    ],
    "require": {
        "php": "^8.2",
        "primix/primix": "^0.7.17",
        "tagixo/core": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "tagixo/document-builder": "^0.1",
        "tagixo/form-builder": "^0.1",
        "tagixo/mail-builder": "^0.1",
        "tagixo/page-builder": "^0.1"
    },
    "repositories": {
        "tagixo": {
            "type": "path",
            "url": "../../Projects/tagixo/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "tagixo/core": "0.1.x-dev",
                    "tagixo/document-builder": "0.1.x-dev",
                    "tagixo/form-builder": "0.1.x-dev",
                    "tagixo/mail-builder": "0.1.x-dev",
                    "tagixo/page-builder": "0.1.x-dev",
                    "tagixo/slider-builder": "0.1.x-dev"
                }
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Tagixo\\Primix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tagixo\\Primix\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Tagixo\\Primix\\TagixoPrimixServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    }
}
